generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MemberRole {
  PLATFORM_ADMIN
  ORG_ADMIN
  ORG_MEMBER
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum ProjectType {
  CORPORATE_WEBSITE
  ECOMMERCE
  FOREIGN_TRADE
  WECHAT_MINI_PROGRAM
  WEB_ADMIN
  API_SERVICE
  OTHER
}

enum HealthStatus {
  HEALTHY
  WARNING
  DOWN
  UNKNOWN
}

enum MonitorType {
  HTTP
  API
  SSL
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  RECOVERED
  RESOLVED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TicketStatus {
  PENDING
  IN_PROGRESS
  WAITING_CUSTOMER
  COMPLETED
  CLOSED
}

enum QuoteStatus {
  PENDING
  ACCEPTED
  IN_DEVELOPMENT
  DELIVERED
  CANCELLED
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id                 String               @id @default(cuid())
  name               String?
  email              String               @unique
  emailVerified      DateTime?
  image              String?
  passwordHash       String?
  accounts           Account[]
  sessions           Session[]
  memberships        OrganizationMember[]
  projectAccess      ProjectAccess[]
  ticketsCreated     Ticket[]             @relation("TicketCreator")
  ticketMessages     TicketMessage[]
  maintenanceRecords MaintenanceRecord[]
  auditLogs          AuditLog[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refreshToken      String? @map("refresh_token")
  accessToken       String? @map("access_token")
  expiresAt         Int?    @map("expires_at")
  tokenType         String? @map("token_type")
  scope             String?
  idToken           String? @map("id_token")
  sessionState      String? @map("session_state")
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Organization {
  id                 String               @id @default(cuid())
  name               String
  slug               String               @unique
  contactName        String?
  contactPhone       String?
  status             OrganizationStatus   @default(ACTIVE)
  members            OrganizationMember[]
  projects           Project[]
  monitors           Monitor[]
  incidents          Incident[]
  tickets            Ticket[]
  maintenanceRecords MaintenanceRecord[]
  subscriptions      Subscription[]
  serviceUsages      ServiceUsage[]
  quotes             Quote[]
  notifications      Notification[]
  domainRecords      DomainRecord[]
  monthlyReports     MonthlyReport[]
  auditLogs          AuditLog[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           MemberRole   @default(ORG_MEMBER)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt       DateTime     @default(now())

  @@unique([organizationId, userId])
  @@index([userId])
}

model Project {
  id                 String              @id @default(cuid())
  organizationId     String
  name               String
  type               ProjectType
  websiteUrl         String?
  ownerName          String?
  contactInfo        String?
  serverNotes        String?
  techStack          String?
  launchDate         DateTime?
  notes              String?
  healthStatus       HealthStatus        @default(UNKNOWN)
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberAccess       ProjectAccess[]
  monitors           Monitor[]
  incidents          Incident[]
  tickets            Ticket[]
  maintenanceRecords MaintenanceRecord[]
  domainRecords      DomainRecord[]
  quotes             Quote[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([organizationId])
  @@index([organizationId, healthStatus])
}

model ProjectAccess {
  id        String  @id @default(cuid())
  projectId String
  userId    String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model Monitor {
  id                  String            @id @default(cuid())
  organizationId      String
  projectId           String
  name                String
  type                MonitorType
  url                 String
  intervalMinutes     Int               @default(5)
  timeoutMs           Int               @default(10000)
  enabled             Boolean           @default(true)
  consecutiveFailures Int               @default(0)
  healthStatus        HealthStatus      @default(UNKNOWN)
  organization        Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project             Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  checks              MonitorCheck[]
  incidents           Incident[]
  apiConfig           ApiMonitorConfig?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([organizationId])
  @@index([projectId])
  @@index([enabled, intervalMinutes])
}

model MonitorCheck {
  id             String   @id @default(cuid())
  monitorId      String
  httpStatus     Int?
  responseTimeMs Int?
  successful     Boolean
  errorCode      String?
  errorMessage   String?
  checkedAt      DateTime @default(now())
  monitor        Monitor  @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId, checkedAt])
}

model Incident {
  id              String         @id @default(cuid())
  incidentNumber  String         @unique
  organizationId  String
  projectId       String
  monitorId       String?
  type            String
  status          IncidentStatus @default(OPEN)
  firstDetectedAt DateTime
  recoveredAt     DateTime?
  resolvedAt      DateTime?
  httpStatus      Int?
  errorMessage    String?
  notes           String?
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  monitor         Monitor?       @relation(fields: [monitorId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([organizationId, status])
  @@index([monitorId])
}

model Ticket {
  id                 String              @id @default(cuid())
  ticketNumber       String              @unique
  organizationId     String
  projectId          String?
  createdById        String
  assignedToName     String?
  title              String
  category           String
  priority           TicketPriority      @default(NORMAL)
  status             TicketStatus        @default(PENDING)
  description        String
  contactName        String?
  attachments        Json?
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project            Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy          User                @relation("TicketCreator", fields: [createdById], references: [id])
  messages           TicketMessage[]
  maintenanceRecords MaintenanceRecord[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([organizationId, status])
  @@index([projectId])
}

model TicketMessage {
  id          String   @id @default(cuid())
  ticketId    String
  authorId    String
  content     String
  isInternal  Boolean  @default(false)
  attachments Json?
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author      User     @relation(fields: [authorId], references: [id])
  createdAt   DateTime @default(now())

  @@index([ticketId, createdAt])
}

model MaintenanceRecord {
  id              String        @id @default(cuid())
  organizationId  String
  projectId       String
  ticketId        String?
  technicianId    String
  title           String
  description     String?
  durationMinutes Int
  status          String        @default("COMPLETED")
  performedAt     DateTime      @default(now())
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ticket          Ticket?       @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  technician      User          @relation(fields: [technicianId], references: [id])
  serviceUsage    ServiceUsage?
  createdAt       DateTime      @default(now())

  @@index([organizationId, performedAt])
  @@index([projectId])
}

model Plan {
  id                     String         @id @default(cuid())
  name                   String
  slug                   String         @unique
  monthlyPriceCents      Int
  projectLimit           Int?
  monitorLimit           Int?
  serviceMinutesPerMonth Int?
  features               Json
  active                 Boolean        @default(true)
  subscriptions          Subscription[]
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
}

model Subscription {
  id             String       @id @default(cuid())
  organizationId String
  planId         String
  status         String       @default("ACTIVE")
  startsAt       DateTime
  expiresAt      DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan           Plan         @relation(fields: [planId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, status])
}

model ServiceUsage {
  id                  String             @id @default(cuid())
  organizationId      String
  maintenanceRecordId String?            @unique
  minutes             Int
  usageMonth          DateTime
  description         String?
  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  maintenanceRecord   MaintenanceRecord? @relation(fields: [maintenanceRecordId], references: [id], onDelete: SetNull)
  createdAt           DateTime           @default(now())

  @@index([organizationId, usageMonth])
}

model Quote {
  id             String       @id @default(cuid())
  quoteNumber    String       @unique
  organizationId String
  projectId      String?
  title          String
  description    String?
  amountCents    Int
  estimatedDays  Int?
  status         QuoteStatus  @default(PENDING)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  items          QuoteItem[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, status])
}

model QuoteItem {
  id             String @id @default(cuid())
  quoteId        String
  description    String
  quantity       Int    @default(1)
  unitPriceCents Int
  quote          Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
}

model Notification {
  id             String             @id @default(cuid())
  organizationId String
  type           String
  channel        String             @default("EMAIL")
  recipient      String
  subject        String
  content        String
  status         NotificationStatus @default(PENDING)
  sentAt         DateTime?
  errorMessage   String?
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime           @default(now())

  @@index([organizationId, status])
}

model DomainRecord {
  id             String       @id @default(cuid())
  organizationId String
  projectId      String?
  domain         String
  registrar      String?
  expiresAt      DateTime?
  autoRenew      Boolean      @default(false)
  notes          String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, domain])
  @@index([organizationId, expiresAt])
}

model ApiMonitorConfig {
  id                      String  @id @default(cuid())
  monitorId               String  @unique
  method                  String  @default("GET")
  encryptedHeaders        String?
  encryptedBody           String?
  expectedStatusCode      Int     @default(200)
  expectedResponseKeyword String?
  monitor                 Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)
}

model MonthlyReport {
  id             String       @id @default(cuid())
  organizationId String
  reportMonth    DateTime
  summary        Json
  pdfPath        String?
  generatedAt    DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, reportMonth])
}

model AuditLog {
  id             String        @id @default(cuid())
  organizationId String?
  actorId        String?
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  ipAddress      String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor          User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt])
  @@index([actorId])
}
