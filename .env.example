# PostgreSQL 连接串
DATABASE_URL="postgresql://sitecare:sitecare@localhost:5432/sitecare?schema=public"

# Redis 将在第二阶段由监控队列使用
REDIS_URL="redis://localhost:6379"

# 使用 openssl rand -base64 32 或等价方式生成，不要提交真实值
AUTH_SECRET="replace-with-at-least-32-random-characters"
APP_URL="http://localhost:3000"

# 邮件通知（第三阶段接入）
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# API 密钥加密（第二阶段起使用，32 字节随机值）
ENCRYPTION_KEY="replace-with-32-byte-encryption-key"
UPLOAD_DIR="./storage/uploads"
MONITOR_WORKER_CONCURRENCY="5"
